<button class="to-top" id="toTop" aria-label="Back to top">
  <svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
</button>

<script>
(function(){
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const header = document.getElementById('header');
  const toTop  = document.getElementById('toTop');
  const onScroll = () => {
    header.classList.toggle('scrolled', scrollY > 10);
    toTop.classList.toggle('show', scrollY > 600);
  };
  addEventListener('scroll', onScroll, {passive:true}); onScroll();
  toTop.addEventListener('click', () => scrollTo({top:0, behavior: reduced ? 'auto' : 'smooth'}));

  const toggle = document.getElementById('navToggle');
  const backdrop = document.getElementById('backdrop');
  const setPanel = open => {
    document.body.classList.toggle('panel-open', open);
    toggle.setAttribute('aria-expanded', open);
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setPanel(!document.body.classList.contains('panel-open')));
  backdrop.addEventListener('click', () => setPanel(false));
  document.querySelectorAll('.mobile-panel a').forEach(a => a.addEventListener('click', () => setPanel(false)));
  addEventListener('keydown', e => { if (e.key === 'Escape') setPanel(false); });

  const revealIO = new IntersectionObserver(entries => {
    entries.forEach(en => { if (en.isIntersecting){ en.target.classList.add('in'); revealIO.unobserve(en.target); } });
  }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
  document.querySelectorAll('.reveal').forEach(el => reduced ? el.classList.add('in') : revealIO.observe(el));

  const fmt = (n, suf) => n.toLocaleString('en-US') + suf;
  const runCount = el => {
    const target = +el.dataset.count, suf = el.dataset.suffix || '';
    if (reduced){ el.textContent = fmt(target, suf); return; }
    const dur = 1700, start = performance.now();
    (function tick(t){
      const p = Math.min((t - start) / dur, 1), e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(Math.round(target * e), suf);
      if (p < 1) requestAnimationFrame(tick);
    })(start);
  };
  const countIO = new IntersectionObserver(entries => {
    entries.forEach(en => { if (en.isIntersecting){ runCount(en.target); countIO.unobserve(en.target); } });
  }, {threshold:.5});
  document.querySelectorAll('.num[data-count]').forEach(el => countIO.observe(el));

  const spyLinks = [...document.querySelectorAll('.main-nav a[data-spy]')];
  const spyIO = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if (en.isIntersecting){
        const id = en.target.id === 'home' ? 'top' : en.target.id;
        spyLinks.forEach(l => l.classList.toggle('active', l.dataset.spy === id));
      }
    });
  }, {rootMargin:'-40% 0px -55% 0px'});
  ['home','programs','impact','news','contact','donate'].forEach(id => {
    const s = document.getElementById(id); if (s) spyIO.observe(s);
  });

  const openEmailDraft = (subject, body) => {
    location.href = `mailto:info@wadan.org.pk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };

  document.getElementById('nlForm').addEventListener('submit', function(e){
    e.preventDefault();
    const email = this.querySelector('input').value.trim();
    openEmailDraft('Newsletter subscription request', `Please subscribe this email address to WADAN Foundation updates: ${email}`);
    const btn = this.querySelector('button');
    btn.textContent = 'Email Draft Opened';
    btn.disabled = true;
    this.querySelector('input').value = '';
    setTimeout(() => { btn.textContent = 'Subscribe'; btn.disabled = false; }, 3200);
  });

  document.getElementById('contactForm').addEventListener('submit', function(e){
    e.preventDefault();
    const name = document.getElementById('cfName').value.trim();
    const email = document.getElementById('cfEmail').value.trim();
    const subject = document.getElementById('cfSubject').value.trim() || 'Website contact request';
    const message = document.getElementById('cfMsg').value.trim();
    openEmailDraft(subject, `Name: ${name}\nEmail: ${email}\n\n${message}`);
    const btn = this.querySelector('button[type="submit"]');
    const original = btn.innerHTML;
    btn.innerHTML = 'Email Draft Opened';
    btn.disabled = true;
    document.getElementById('contactStatus').textContent = 'Your email app should now contain the message.';
    setTimeout(() => { btn.innerHTML = original; btn.disabled = false; this.reset(); }, 3200);
  });

  /* Donate card */
  const donateForm = document.getElementById('donateForm');
  const amountGrid = document.getElementById('amountGrid');
  const customInput = document.getElementById('dfCustom');
  const submitBtn = document.getElementById('donateSubmit');
  const freqBtns = donateForm.querySelectorAll('.freq-btn');
  let frequency = 'once', amount = 6000;

  const fmtPKR = n => 'PKR ' + n.toLocaleString('en-PK');
  const refreshSubmit = () => {
    submitBtn.innerHTML = `Donate ${fmtPKR(amount)}${frequency === 'monthly' ? ' / month' : ''} <svg class="arr" viewBox="0 0 20 20"><path d="M3 10h13M11 5l5 5-5 5"/></svg>`;
  };

  freqBtns.forEach(b => b.addEventListener('click', () => {
    freqBtns.forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    frequency = b.dataset.freq;
    refreshSubmit();
  }));

  amountGrid.querySelectorAll('.amt-btn').forEach(b => b.addEventListener('click', () => {
    amountGrid.querySelectorAll('.amt-btn').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    amount = +b.dataset.amt;
    customInput.value = '';
    refreshSubmit();
  }));

  customInput.addEventListener('input', () => {
    if (customInput.value){
      amountGrid.querySelectorAll('.amt-btn').forEach(x => x.classList.remove('active'));
      amount = +customInput.value || 0;
      refreshSubmit();
    }
  });

  donateForm.addEventListener('submit', function(e){
    e.preventDefault();
    if (!amount || amount < 100){ customInput.focus(); return; }
    const name = document.getElementById('dfName').value.trim();
    const email = document.getElementById('dfEmail').value.trim();
    openEmailDraft(`${frequency === 'monthly' ? 'Monthly' : 'One-time'} donation request: ${fmtPKR(amount)}`, `Name: ${name}\nEmail: ${email}\nAmount: ${fmtPKR(amount)}${frequency === 'monthly' ? ' per month' : ''}`);
    const original = submitBtn.innerHTML;
    submitBtn.innerHTML = 'Email Draft Opened';
    submitBtn.disabled = true;
    setTimeout(() => { submitBtn.disabled = false; refreshSubmit(); }, 3200);
  });
})();
</script>
<style>
  .donate{display:none}
  .donate.open{display:block;animation:donIn .5s cubic-bezier(.22,.61,.36,1)}
  @keyframes donIn{from{opacity:0;transform:translateY(24px)}}
  .don-close{position:absolute;top:22px;right:22px;z-index:3;width:42px;height:42px;border-radius:50%;border:1.5px solid rgba(255,255,255,.4);background:rgba(255,255,255,.08);color:#fff;font-size:22px;line-height:1;cursor:pointer;transition:background .2s}
  .don-close:hover{background:rgba(255,255,255,.2)}
</style>
<script>
(function(){
  var sec = document.getElementById('donate');
  if(!sec) return;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  var close = document.createElement('button');
  close.type = 'button';
  close.className = 'don-close';
  close.setAttribute('aria-label', 'Close donation section');
  close.innerHTML = '&times;';
  var inner = sec.querySelector('.donate-inner');
  (inner || sec).prepend(close);

  function openDonate(e){
    if(e) e.preventDefault();
    sec.classList.add('open');
    sec.scrollIntoView({behavior: reduce ? 'auto' : 'smooth'});
    setTimeout(function(){
      var n = document.getElementById('dfName');
      if(n) n.focus({preventScroll:true});
    }, 600);
  }

  document.querySelectorAll('a[href="#donate"]').forEach(function(a){
    a.addEventListener('click', openDonate);
  });

  close.addEventListener('click', function(){
    sec.classList.remove('open');
    scrollTo({top:0, behavior: reduce ? 'auto' : 'smooth'});
  });

  if(location.hash === '#donate') openDonate();
})();
</script>
</body>
</html>
